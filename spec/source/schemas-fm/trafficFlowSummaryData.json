{
  "id": "http://gigamon.com/schemas-fm/trafficFlowSummaryData.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for TrafficFlowsSummaryData and related response wrappers.",
  "definitions": {
