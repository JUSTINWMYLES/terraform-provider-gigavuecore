        },
        "sourceRulesSummary": {
          "type": "object",
          "description": "Map of RuleType to Counter. eg. ByRule : 2",
          "propertyNames": {
            "enum": [
              "byRule",
              "passAll",
              "collector",
              "flowFilter",
              "flowSample",
              "flowSample5g",
              "flowWhitelist5g",
              "flowWhitelist",
              "flowSampleOverlap",
              "flowWhitelistOverlap",
              "ingressToVp",
              "egressFromVp",
              "oobFromVp",
              "flowSampleSip",
              "flowWhitelistSip",
              "flowSampleDiameter",
              "flowWhitelistDiameter",
              "networkEnd",
              "flowSample5gOverlap",
              "flowWhitelist5gOverlap",
              "inlinePair"
            ]
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "apps": {
          "$ref": "#/definitions/ComponentSummary"
        },
        "appRulesSummary": {
          "type": "object",
          "description": "Map of RuleType to Counter. eg. ByRule : 2",
          "propertyNames": {
            "enum": [
              "byRule",
              "passAll",
              "collector",
              "flowFilter",
              "flowSample",
              "flowSample5g",
              "flowWhitelist5g",
              "flowWhitelist",
              "flowSampleOverlap",
              "flowWhitelistOverlap",
              "ingressToVp",
              "egressFromVp",
              "oobFromVp",
              "flowSampleSip",
              "flowWhitelistSip",
              "flowSampleDiameter",
              "flowWhitelistDiameter",
              "networkEnd",
              "flowSample5gOverlap",
              "flowWhitelist5gOverlap",
              "inlinePair"
            ]
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "destinations": {
          "$ref": "#/definitions/ComponentSummary"
        },
        "configStatus": {
          "type": "string"
        },
        "hasDraft": {
          "type": "boolean"
        },
        "healthState": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthState",
          "readonly": true
        },
        "healthStateReasons": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthStateReasons",
          "readonly": true
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "../schemas-common/common.json#/definitions/ResourceTag"
          }
        }
      },
      "required": [
        "alias"
      ],
      "additionalProperties": false
    },
    "ComponentSummary": {
      "id": "#/definitions/ComponentSummary",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "healthState": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthState",
          "readonly": true
        },
        "healthStateReasons": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthStateReasons",
          "readonly": true
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
