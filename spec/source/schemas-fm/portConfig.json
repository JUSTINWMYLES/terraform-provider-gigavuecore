    "PortPtp": {
      "description": "Port PTP configurations",
      "properties": {
        "enable": {
          "description": "Enable PTP on the port",
          "type": "boolean"
        },
        "localPriority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "role": {
          "deprecated": true,
          "type": "string",
          "enum": [
            "standard",
            "master",
            "slave"
          ],
          "description": "deprecated: use roleAlias"
        },
        "roleAlias": {
          "type": "string",
          "enum": [
            "standard",
            "source",
            "receiver"
          ]
        },
        "announceInterval": {
          "description": "Configures the interval between PTP announce messages on an interface.\nThe range for the PTP announcement interval is from -2 to 4 log seconds.\nFor the domain 0 as well as domain 24 to 43 the interval limit will be of -3 to 4",
          "type": "integer"
        },
        "delayRequestInterval": {
          "description": "Configures the minimum interval allowed between PTP delay messages when the port is in the source state.\nThe range is from log(-7) to log(5) seconds, where log(-1) = 1 frame per second.\nFor the domain 0 the interval limit is -4 to 5 and for the range of domain 24 to 43 the interval limit will be of -7 to 4.",
          "type": "integer"
        },
        "syncInterval": {
          "description": "Configures the interval between PTP synchronization messages on an interface.\nThe range is from log(-7) to log(1) seconds.\nFor domain 0 the interval limit is -4 to 1 and for the range of domain 24 to 43 the interval limit will be of -7 to 4. ",
          "type": "integer"
        },
        "timestamp": {
          "$ref": "#/definitions/PortPtpTimestamp"
        },
        "vlan": {
          "description": "configures vlan on the PTP configured port",
          "type": "integer",
          "minimum": 4080,
          "maximum": 4089
        }
      },
      "type": "object"
    },
    "PortPtpTimestamp": {
      "description": "Port PTP timestamp configurations",
      "properties": {
        "egress": {
          "$ref": "#/definitions/PortPtpTimestampDirConfig",
          "description": "Tx (Egress) settings"
        },
        "ingress": {
          "$ref": "#/definitions/PortPtpTimestampDirConfig",
          "description": "Rx (Ingress) settings"
        }
      },
      "type": "object"
    },
    "PortPtpTimestampDirConfig": {
      "properties": {
        "insert": {
          "default": false,
          "description": "When set, will insert timestamp for packets on the port",
          "type": "boolean"
        },
        "sourceId": {
          "description": "Source identifier of Packet Time Stamp record header",
          "minimum": 0,
          "maximum": 65535,
          "type": "integer"
        }
      },
      "type": "object"
    },
