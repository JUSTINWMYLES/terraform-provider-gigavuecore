{
  "id": "http://gigamon.com/schemas-fm/crypto.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "GigaFabricPath": {
      "id": "#/definitions/GigaFabricPath",
      "additionalProperties": false,
      "description": "detailed information about the Fabric Path",
      "properties": {
        "gfpId": {
          "type": "integer",
          "description": "Can be a hash number from alias string"
        },
        "alias": {
          "type": "string",
          "description": "Composing from srcClusterUUID and dstClusterUUID strings, i.e., srcClusterUUID-to-dstClusterUUID"
        },
        "srcClusterUUID": {
          "type": "string",
          "description": "All srcVertices must be from same srcClusterUUID"
        },
        "dstClusterUUID": {
          "type": "string",
          "description": "All dstVertices must be from same dstClusterUUID"
        },
        "srcVertices": {
          "type": "array",
          "items": {
            "$ref": "portConfig.json#/definitions/Gigastream"
          }
        },
        "dstVertices": {
          "type": "array",
          "items": {
            "$ref": "portConfig.json#/definitions/Gigastream"
          }
        },
        "topologyLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TopologyLink"
          }
        },
        "operationState": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "UP",
            "DOWN",
            "PARTIAL_UP",
            "DISCONNECTED",
            "ERROR"
          ],
          "default": "UNKNOWN",
          "description": "Operation state of the fabric path"
        },
        "configState": {
          "type": "string",
          "enum": [
            "NORMAL",
            "CONFLICTING"
          ],
          "default": "NORMAL",
          "description": "Configuration state of the fabric path"
        },
        "pathType": {
          "type": "string",
          "enum": [
            "GIGASTREAM",
            "GDP_FOUND",
            "VXLAN"
          ],
          "default": "GIGASTREAM",
          "description": "Type for Fabric Path"
        },
        "version": {
          "type": "integer",
          "description": "Incremental version field to indicate the fabric path format"
        },
        "referenced": {
          "type": "string",
          "default": false,
          "description": "Reference boolean of fabric path"
        }
      }
    },
    "TopologyLink": {
      "id": "#/definitions/TopologyLink",
      "additionalProperties": false,
      "description": "detailed information about the Topology Link",
      "properties": {
        "topoLinkId": {
          "type": "string",
          "description": "unique Id representing a topology graph link. Generated by FM server"
        },
        "linkAlias": {
          "type": "string",
          "description": "alias of the link"
        },
        "topoLinkType": {
          "type": "string",
          "enum": [
            "gigamon",
            "manual",
            "lldp",
            "cdp"
          ],
          "description": "indicates how link became a pert of this topology graph"
        },
        "gigaLinkType": {
          "type": "string",
          "enum": [
            "gigastream",
            "port"
          ],
          "description": "specifies whether this is a gigastream-based or port-based link. Only applicable for topoNodeType of 'gigamon'"
        },
        "discoveryState": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ],
          "description": "specifies the discovery state of the topo link"
        },
        "comment": {
          "type": "string"
        },
        "manualOverride": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether manual augmentation exist. Only applicable for topoLinkType of 'cdp' or 'lldp'"
        },
        "endpoint1": {
          "$ref": "topology.json#/definitions/GigaTopologyNodeLinkEndpoint"
        },
        "endpoint2": {
          "$ref": "topology.json#/definitions/GigaTopologyNodeLinkEndpoint"
        },
        "aggregatedLink": {
          "type": "boolean",
          "default": false
        },
        "linkState": {
          "type": "string",
          "enum": [
            "up",
            "unknown",
            "error",
            "down",
            "partial"
          ],
          "description": "specifies health state"
        }
      },
      "numOfLinks": {
        "type": "integer",
        "description": "specifies the total number of links"
      },
      "connections": {
        "description": "Actual port-ids which are part of the physical connection",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "port1": {
              "type": "string"
            },
            "port2": {
              "type": "string"
            },
            "port1Reported": {
              "type": "boolean"
            },
            "port2Reported": {
              "type": "boolean"
            },
            "manualLinkId": {
              "type": "string"
            },
            "linkState": {
              "type": "string",
              "enum": [
                "up",
                "unknown",
                "down"
              ],
              "description": "specifies health state"
            }
          }
        }
      }
    },
    "GigaTopologyFabricPathsDetails": {
      "id": "#/definitions/GigaTopologyFabricPathsDetails",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gigaTopologyFabricPathsDetails"
      ],
      "properties": {
        "gigaTopologyFabricPathsDetails": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaFabricPath"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    }
  }
}