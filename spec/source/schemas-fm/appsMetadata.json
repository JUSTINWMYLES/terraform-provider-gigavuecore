        "templateType": {
          "type": "string",
          "enum": [
            "cohesive",
            "segregated"
          ]
        },
        "activeTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 604800,
          "description": "in seconds"
        },
        "inactiveTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 604800,
          "description": "in seconds"
        }
      }
    },
