          "$ref": "appsMetadata.json#/definitions/MetadataExporterCef",
          "description": "cef attributes"
        },
        "monitor": {
          "$ref": "appsMetadata.json#/definitions/MetadataExporterMonitor",
          "description": "monitor attributes"
        },
        "snmp": {
          "$ref": "appsMetadata.json#/definitions/MetadataExporterSnmp"
        },
        "maxPktSize": {
          "type": "integer",
          "format": "int32"
        },
        "applicationProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "application profile aliases to attach to the exporter"
        },
        "mobilitySam": {
          "$ref": "appsMetadata.json#/definitions/MetadataExporterSam"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "MetadataExporterSnmp": {
      "id": "#/definitions/MetadataExporterSnmp",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "snmp reverse lookup enable/disable"
        }
      }
    },
    "MetadataExporterSam": {
      "id": "#/definitions/MetadataExporterSam",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "default": "Immediate"
        },
        "encoding": {
          "type": "string",
          "default": "JSON"
        },
        "encodingFormat": {
          "type": "string",
          "enum": [
            "hierarchy",
            "flat"
          ],
          "default": "hierarchy"
        },
        "eventEnable": {
          "type": "object",
          "properties": {
            "modify": {
              "default": false,
              "type": "boolean"
            },
            "update": {
              "default": false,
              "type": "boolean"
            }
          }
        }
      }
    },
    "MetadataExporterMonitor": {
      "id": "#/definitions/MetadataExporterMonitor",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 60,
          "maximum": 900,
          "description": "how often to export in seconds"
        }
      }
    },
    "MetadataExporterCef": {
      "id": "#/definitions/MetadataExporterCef",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 604800,
          "description": "in seconds"
        },
        "inactiveTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 604800,
          "description": "in seconds"
        }
      }
    },
    "MetadataExporterDestination": {
      "id": "#/definitions/MetadataExporterDestination",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipv4Address": {
          "type": "string",
          "format": "ipv4",
          "description": "ipv4 address"
        },
        "dscp": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 63,
          "default": 0
        },
        "ttl": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 255
        },
        "l4Protocol": {
          "type": "string",
          "enum": [
            "udp",
            "tcp"
          ]
        },
        "l4PortDst": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 65535
        },
        "l4PortSrc": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 65535
        }
      }
