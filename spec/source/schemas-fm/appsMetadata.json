          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileInterface"
        },
        "ip": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileIp"
        },
        "ipv4": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileIpv4"
        },
        "ipv6": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileIpv6"
        },
        "outerIpv4": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileOuterIp"
        },
        "outerIpv6": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileOuterIp"
        },
        "gtpu": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileGtpu"
        },
        "timestamp": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileTimestamp"
        },
        "transport": {
          "$ref": "appsMetadata.json#/definitions/MetadataApplicationProfileTransport"
        },
        "description": {
          "type": "string"
        }
      }
