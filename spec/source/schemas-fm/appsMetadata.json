{
  "id": "http://gigamon.com/schemas-fm/appsMetadata.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Apps Metadata Configuration schema",
  "definitions": {
    "MetadataApplicationTemplate": {
      "id": "#/definitions/MetadataApplicationTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "application id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "application name"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "description": "application category name"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "User friendly application name"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetadataApplicationAttributes"
          }
        }
      }
    },
    "MetadataCacheConfig": {
      "id": "#/definitions/MetadataCacheConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/definitions/MetadataCacheSize",
          "description": "Size of flows"
        },
        "timeout": {
          "$ref": "#/definitions/MetadataCacheTimeout"
        },
        "event": {
          "type": "string",
          "enum": [
            "txnEnd",
            "none"
          ],
          "defaultValue": "txnEnd"
        },
        "sampling": {
          "$ref": "#/definitions/MetadataCacheSampling"
        },
        "exporters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "alias of metadata exporters to attach this cache"
        },
        "networkProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "alias of metadata network profiles to attach this cache"
        },
        "match": {
          "$ref": "#/definitions/MetadataCacheMatch",
          "description": "match criteria for record generation"
        },
        "flowBehavior": {
          "type": "string",
          "enum": [
            "unidir",
            "bidir"
          ],
          "description": "direction for flow identification"
        },
        "observationDomainId": {
          "type": "integer",
          "format": "int32"
        },
        "dpiInjectLimit": {
          "type": "integer",
          "format": "int32"
        },
        "multiCollect": {
          "type": "boolean",
          "description": "Collect all attributes as it is discovered when enable. It will export the same record once when disable."
        },
        "advanceHash": {
          "type": "boolean",
          "description": "When scheduling flows for processing, use external encapsulate packet header if disable, use inner packet header if enable."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "MetadataCacheSize": {
      "id": "#/definitions/MetadataCacheSize",
      "type": "object",
      "additionalProperties": false,
      "description": "size of the flows",
