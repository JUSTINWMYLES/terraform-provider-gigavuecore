{
  "id": "http://gigamon.com/schemas-fm/deviceCredentials.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Physical Device Credentials schema",
  "definitions": {
    "DeviceCredentials": {
      "id": "#/definitions/DeviceCredentials",
      "type": "object",
      "additionalProperties": true,
      "description": "Device Credentials definition. Device Credentials. Required if Non-default value(i.e other than 443) is used",
      "required": [
        "deviceAddress",
        "httpUsername",
        "httpPassword"
      ],
      "properties": {
        "deviceAddress": {
          "type": "string",
          "format": "inetAddress",
          "description": "value of '0.0.0.0' represents the default (fallback) device credentials"
        },
        "httpUsername": {
          "type": "string",
          "description": "username to use for device login"
        },
        "httpPassword": {
          "type": "string",
          "description": "password to use for device login. On reads, '*****' is returned"
        },
        "httpsPort": {
          "type": "string",
          "default": "443",
          "description": "httpsPort to use for device communication. By default 443 is used, If changed the same should be given here"
        },
        "hostname": {
          "type": "string",
          "description": "device configured hostname "
        },
        "snmpVersion": {
          "type": "string",
          "enum": [
            "v2",
            "v3"
          ],
          "description": "SNMP version to use."
        }
      }
    },
    "DeviceCredentialsQueryResponse": {
      "id": "#/definitions/DeviceCredentialsQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "devCreds"
      ],
      "properties": {
        "devCreds": {
          "$ref": "#/definitions/DeviceCredentials"
        }
      }
    },
    "DeviceCredentialsListQueryResponse": {
      "id": "#/definitions/DeviceCredentialsListQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "devCredsList"
      ],
      "properties": {
        "devCredsList": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeviceCredentials"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    }
  }
}
