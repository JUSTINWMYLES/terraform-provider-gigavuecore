{
  "id": "http://gigamon.com/schemas-fm/appKeystore.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Apps Keystore schema",
  "definitions": {
    "KeystoreKeyConfig": {
      "id": "#/definitions/KeystoreKeyConfig",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "alias",
        "type"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "private",
            "certificate",
            "pkcs12",
            "pkcs11",
            "ecdsa-private",
            "ecdsa-certificate",
            "ecdsa-pkcs11",
            "ecdsa-pkcs12",
            "luna-rsa-label",
            "luna-ecdsa-label"
          ]
        },
        "comment": {
          "type": "string"
        },
        "passphrase": {
          "type": "string",
          "description": "passphrase applicable for pkcs12 and private only"
        },
        "fileSource": {
          "$ref": "../schemas-common/common.json#/definitions/RemoteFileSpec",
          "description": "Remote location to fetch file from. Mutually exclusive with 'file'"
        },
        "keyLabel": {
          "type": "string",
          "description": "Luna-hsm key label"
        },
        "file": {
          "type": "string",
          "description": "The contents of the file. Mutually exclusive with 'fileSource'"
        }
      }
    },
    "KeystoreKey": {
      "id": "#/definitions/KeystoreKey",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "alias"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "certificate": {
          "type": "boolean",
          "default": false,
          "readOnly": true,
          "description": "true if a certificate key is configured for this alias; readonly"
        },
        "private": {
          "type": "boolean",
          "default": false,
          "readOnly": true,
          "description": "true if a private key is configured for this alias; readonly"
        },
        "type": {
          "type": "string",
          "enum": [
            "pkcs11"
          ],
          "readOnly": true,
          "description": "hsm pkcs11 key; readonly"
        },
        "cn": {
          "type": "string",
          "readOnly": true,
          "description": "certificate common name"
        },
        "ou": {
          "type": "string",
          "readOnly": true,
          "description": "organizational unit - the division of organization handling the certificate"
        },
        "o": {
          "type": "string",
          "readOnly": true,
          "description": "organization name"
        },
        "installedOn": {
          "type": "string",
          "readOnly": true,
          "description": "certificate installation time"
        },
        "expiry": {
          "type": "string",
          "readOnly": true,
          "description": "certificate expiry date"
        },
        "comment": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "healthState": {
          "$ref": "#/definitions/CertificateHealthState"
        },
        "healthStateReasons": {
          "$ref": "#/definitions/CertificateHealthStateReasons"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "id of the defining cluster"
        }
      }
    },
    "RiaKeystoreKeyConfig": {
      "id": "#/definitions/RiaKeystoreKeyConfig",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "alias"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "clusterNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key": {
          "$ref": "#/definitions/RiaKeys",
          "description": "Remote location to fetch file from. Mutually exclusive with 'file'"
        },
        "certificate": {
          "$ref": "#/definitions/RiaCertificate",
          "description": "Remote location to fetch file from. Mutually exclusive with 'file'"
        }
      }
    },
    "RiaCertificate": {
      "id": "#/definitions/RiaCertificate",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "certificate",
            "ecdsa-certificate"
          ]
        },
        "passphrase": {
          "type": "string",
          "description": "passphrase applicable for pkcs12 and private only"
        },
        "certificateUrl": {
          "$ref": "../schemas-common/common.json#/definitions/RemoteFileSpec",
          "description": "Remote location to fetch certificate file from. Mutually exclusive with 'file'"
        },
        "certificateFile": {
          "type": "string",
          "description": "The contents of the certificate file. Mutually exclusive with 'fileSource'"
        }
      }
    },
    "RiaKeys": {
      "id": "#/definitions/RiaKeys",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "private",
            "pkcs12",
            "pkcs11",
            "ecdsa-private",
            "ecdsa-pkcs12",
            "luna-rsa-label",
            "luna-ecdsa-label",
            "luna-hsm-rsa"
          ]
        },
        "passphrase": {
          "type": "string",
          "description": "passphrase applicable for pkcs12 and private only"
        },
        "keyUrl": {
          "$ref": "../schemas-common/common.json#/definitions/RemoteFileSpec",
          "description": "Remote location to fetch key file from. Mutually exclusive with 'file'"
        },
        "keyFile": {
          "type": "string",
          "description": "The contents of the key file. Mutually exclusive with 'fileSource'"
        },
        "keyLabel": {
          "type": "string",
          "description": "Key Label "
        }
      }
    },
    "CertificateHealthState": {
      "id": "#/definitions/CertificateHealthState",
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "readOnly": true,
      "description": "Read-only. 'green' indicates certificate participating in flow; 'yellow'  indicates certificate installed but not participating in any flow; 'red'  indicates certificate expired;"
    },
    "CertificateHealthStateReason": {
      "id": "#/definitions/CertificateHealthStateReason",
      "type": "object",
      "properties": {
        "severity": {
          "$ref": "#/definitions/CertificateHealthState"
        },
        "message": {
          "type": "string",
          "readOnly": true,
          "description": "Read-only. Describes the reason for component's health state"
        }
      }
    },
    "CertificateHealthStateReasons": {
      "id": "#/definitions/CertificateHealthStateReasons",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CertificateHealthStateReason"
      },
      "readOnly": true
    },
    "KeystoreKeyGenerate": {
      "id": "#/definitions/KeystoreKeyGenerate",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "alias",
        "commonName",
        "orgName"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "US"
        },
        "state": {
          "type": "string",
          "default": "CA"
        },
        "orgName": {
          "type": "string"
        },
        "orgUnit": {
          "type": "string"
        },
        "commonName": {
          "type": "string"
        },
        "days": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 2000,
          "default": 730
        },
        "keysize": {
          "type": "integer",
          "format": "int32",
          "enum": [
            256,
            384,
            521,
            1024,
            2048,
            4096
          ],
          "description": "ecdsa sizes: 256, 384, 521; rsa sizes: 1024, 2048, 4096"
        },
        "hashType": {
          "type": "string",
          "enum": [
            "SHA1",
            "SHA256",
            "SHA384",
            "SHA512"
          ],
          "default": "SHA256"
        }
      }
    },
    "KeystoreKeyCertificate": {
      "id": "#/definitions/KeystoreKeyCertificate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate"
      ],
      "properties": {
        "certificate": {
          "type": "string"
        }
      }
    },
    "KeyCounter": {
      "id": "#/definitions/KeyCounter",
      "type": "object",
      "description": "per key counter",
      "properties": {
        "keyAlias": {
          "type": "string",
          "readOnly": true
        },
        "hits": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "readOnly": true
        }
      }
    },
    "KeystoreKeysQueryResponse": {
      "id": "#/definitions/KeystoreKeysQueryResponse",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeystoreKey"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    },
    "KeystoreKeyQueryResponse": {
      "id": "#/definitions/KeystoreKeyQueryResponse",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/KeystoreKey"
        }
      }
    },
    "KeystorePreference": {
      "id": "#/definitions/KeystorePreference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterId"
      ],
      "properties": {
        "clusterId": {
          "type": "string"
        },
        "autoEnable": {
          "type": "boolean",
          "default": false
        },
        "autoDelete": {
          "type": "boolean",
          "default": false
        },
        "retentionTime": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "default": 30
        },
        "autoPurge": {
          "type": "boolean",
          "default": false
        },
        "maxKeys": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "default": 3
        }
      }
    },
    "KeystorePreferenceResponse": {
      "id": "#/definitions/KeystorePreferenceResponse",
      "type": "object",
      "additionalProperties": false,
      "description": "",
      "required": [
        "preference"
      ],
      "properties": {
        "preference": {
          "$ref": "#/definitions/KeystorePreference"
        }
      }
    }
  }
}
