{
  "id": "http://gigamon.com/schemas-fm/appsInlineSsl.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Apps Inline SSL Configuration schema",
  "definitions": {
    "InlineSslConfig": {
      "id": "#/definitions/InlineSslConfig",
      "type": "object",
      "additionalProperties": false,
      "description": "inline SSL configuration parameters",
      "properties": {
        "caching": {
          "$ref": "#/definitions/InlineSslCaching"
        },
        "sslVersions": {
          "$ref": "#/definitions/InlineSslVersions"
        },
        "resumption": {
          "$ref": "#/definitions/InlineSslResumption"
        },
        "startTls": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "monitor": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse",
          "deprecated": true,
          "description": "This property is moved to ssl profile for device version >=5.7"
        },
        "dheCiphersuit": {
          "type": "string",
          "enum": [
            "disable",
            "enable"
          ],
          "default": "disable"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "id of the defining cluster"
        }
      }
    },
    "InlineSslResumption": {
      "id": "#/definitions/InlineSslResumption",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "$ref": "#/definitions/InlineSslGenericEnableTrue",
          "description": "enable client initiated resumption (for debug purposes only)"
        }
      }
    },
    "InlineSslGenericEnableTrue": {
      "id": "#/definitions/InlineSslGenericEnableTrue",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "InlineSslGenericEnableFalse": {
      "id": "#/definitions/InlineSslGenericEnableFalse",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "InlineSslVersions": {
      "id": "#/definitions/InlineSslVersions",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minVersion",
        "maxVersion"
      ],
      "properties": {
        "minVersion": {
          "type": "string",
          "enum": [
            "sslv3",
            "tls1",
            "tls11",
            "tls12",
            "tls13"
          ]
        },
        "connectionResetActionForMinVersion": {
          "type": "string",
          "enum": [
            "no-decrypt",
            "drop"
          ],
          "default": "drop",
          "description": "Action to take to reset connection if TLS version is lower than configured"
        },
        "maxVersion": {
          "type": "string",
          "enum": [
            "sslv3",
            "tls1",
            "tls11",
            "tls12",
            "tls13"
          ],
          "description": "maxVersion must be greater than minVersion"
        },
        "connectionResetActionForMaxVersion": {
          "type": "string",
          "enum": [
            "no-decrypt",
            "drop"
          ],
          "default": "no-decrypt",
          "description": "Action to take to reset connection if TLS version is higher than configured"
        }
      }
    },
    "InlineSslCaching": {
      "id": "#/definitions/InlineSslCaching",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfile": {
      "id": "#/definitions/InlineSslProfile",
      "type": "object",
      "additionalProperties": false,
      "description": "Inline SSL Profile",
      "required": [
        "alias"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Alias of the inline SSL profile"
        },
        "certificate": {
          "$ref": "#/definitions/InlineSslProfileCertificate",
          "description": "SSL profile certificate configuration"
        },
        "decrypt": {
          "$ref": "#/definitions/InlineSslProfileDecrypt",
          "description": "SSL profile configuration on decrypt action"
        },
        "noDecrypt": {
          "$ref": "#/definitions/InlineSslProfileNoDecrypt",
          "description": "SSL profile configuration on no-decrypt action"
        },
        "nonSslTcp": {
          "$ref": "#/definitions/InlineSslProfileNonSslTcp",
          "description": "SSL profile configuration on TCP proxy action"
        },
        "tcp": {
          "$ref": "#/definitions/InlineSslProfileTcp",
          "description": "SSL profile configuration on TCP"
        },
        "highAvail": {
          "$ref": "#/definitions/InlineSslProfileHa",
          "description": "SSL profile configuration on high availability"
        },
        "networkGroup": {
          "$ref": "#/definitions/InlineSslProfileNetworkGroup",
          "description": "SSL Profile configuration for multiple entry in network groups"
        },
        "monitor": {
          "type": "string",
          "enum": [
            "enable",
            "disable",
            "inline"
          ],
          "default": "disable"
        },
        "defaultAction": {
          "type": "string",
          "description": "Action to take if none of the profile rules match",
          "enum": [
            "decrypt",
            "no-decrypt"
          ],
          "default": "no-decrypt"
        },
        "tool": {
          "$ref": "#/definitions/InlineSslProfileToolConfig",
          "description": "SSL Profile configuration for Tools"
        },
        "startTls": {
          "$ref": "#/definitions/InlineSslProfileStartTls",
          "description": "SSL profile configuration on start TLS action"
        },
        "urlCache": {
          "$ref": "#/definitions/InlineSslProfileUrlCache",
          "description": "SSL profile configuration on url-cache"
        },
        "rules": {
          "type": "array",
          "description": "inline SSL profile rules",
          "items": {
            "$ref": "#/definitions/InlineSslProfileRule"
          }
        },
        "keyMap": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InlineSslProfileKeyMap"
          }
        },
        "splitProxy": {
          "$ref": "#/definitions/InlineSslProfileSplitProxy",
          "description": "SSL profile configuration for Split Proxy"
        },
        "oneArm": {
          "type": "string",
          "enum": [
            "enable",
            "disable"
          ],
          "default": "disable"
        },
        "resilientInline": {
          "$ref": "#/definitions/InlineSslProfileResilientInline",
          "description": "SSL profile configuration for Resilient Inline Arrangement"
        },
        "toolL3": {
          "$ref": "#/definitions/InlineSslProfileToolL3",
          "description": "SSL profile configuration for Layer 3 ISSL"
        },
        "inboundToolEarlyInspect": {
          "$ref": "#/definitions/InboundToolEarlyInspect",
          "description": "SSL profile configuration for InboundToolEarlyInspect"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "id of the defining cluster"
        }
      }
    },
    "InlineSslProfileTcp": {
      "id": "#/definitions/InlineSslProfileTcp",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timewaitTimeout": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "maximum": 300,
          "description": "TCP Wait Timeout value"
        },
        "delayedAck": {
          "type": "boolean",
          "default": false,
          "description": "enable/disable TCP delayed ACK"
        },
        "synRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "TCP Sync retries"
        }
      }
    },
    "InlineSslProfileKeyMaps": {
      "id": "#/definitions/InlineSslProfileKeyMaps",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyMaps"
      ],
      "properties": {
        "keyMaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InlineSslProfileKeyMap"
          }
        }
      }
    },
    "InlineSslProfileKeyMap": {
      "id": "#/definitions/InlineSslProfileKeyMap",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "key"
      ],
      "properties": {
        "ruleId": {
          "type": "integer",
          "readonly": true,
          "example": 1
        },
        "hostname": {
          "type": "string",
          "description": "hostname or IP address"
        },
        "key": {
          "type": "string",
          "description": "SSL key alias"
        }
      }
    },
    "InlineSslProfileRules": {
      "id": "#/definitions/InlineSslProfileRules",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "inline SSL profile rules",
          "items": {
            "$ref": "#/definitions/InlineSslProfileRule"
          }
        }
      }
    },
    "InlineSslProfileRule": {
      "id": "#/definitions/InlineSslProfileRule",
      "type": "object",
      "additionalProperties": true,
      "description": "inline SSL profile rule",
      "example": {
        "type": "domain",
        "ruleId": 1,
        "value": "string",
        "action": "decrypt"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/InlineSslProfileRuleDomain"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleCategory"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleIssuer"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleIpv4"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleL4Port"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleVlan"
        },
        {
          "$ref": "#/definitions/InlineSslProfileRuleIpv6"
        }
      ]
    },
    "InlineSslProfileConfig": {
      "id": "#/definitions/InlineSslProfileConfig",
      "type": "object",
      "additionalProperties": false,
      "description": "Inline SSL Profile",
      "required": [
        "alias"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Alias of the inline SSL profile"
        },
        "certificate": {
          "$ref": "#/definitions/InlineSslProfileCertificate",
          "description": "SSL profile certificate configuration"
        },
        "decrypt": {
          "$ref": "#/definitions/InlineSslProfileDecryptConfig",
          "description": "SSL profile configuration on decrypt action"
        },
        "noDecrypt": {
          "$ref": "#/definitions/InlineSslProfileNoDecrypt",
          "description": "SSL profile configuration on no-decrypt action"
        },
        "nonSslTcp": {
          "$ref": "#/definitions/InlineSslProfileNonSslTcp",
          "description": "SSL profile configuration on TCP proxy action"
        },
        "tcp": {
          "$ref": "#/definitions/InlineSslProfileTcp",
          "description": "SSL profile configuration on TCP"
        },
        "highAvail": {
          "$ref": "#/definitions/InlineSslProfileHa",
          "description": "SSL profile configuration on high availability"
        },
        "networkGroup": {
          "$ref": "#/definitions/InlineSslProfileNetworkGroup",
          "description": "SSL Profile configuration for multiple entry in network groups"
        },
        "monitor": {
          "type": "string",
          "enum": [
            "enable",
            "disable",
            "inline"
          ],
          "default": "disable"
        },
        "defaultAction": {
          "type": "string",
          "description": "Action to take if none of the profile rules match",
          "enum": [
            "decrypt",
            "no-decrypt"
          ],
          "default": "no-decrypt"
        },
        "tool": {
          "$ref": "#/definitions/InlineSslProfileToolConfig",
          "description": "SSL Profile configuration for Tools"
        },
        "startTls": {
          "$ref": "#/definitions/InlineSslProfileStartTls",
          "description": "SSL profile configuration on start TLS action"
        },
        "urlCache": {
          "$ref": "#/definitions/InlineSslProfileUrlCache",
          "description": "SSL profile configuration on url-cache"
        },
        "splitProxy": {
          "$ref": "#/definitions/InlineSslProfileSplitProxy",
          "description": "SSL profile configuration for Split Proxy"
        },
        "oneArm": {
          "type": "string",
          "enum": [
            "enable",
            "disable"
          ],
          "default": "disable"
        }
      }
    },
    "InlineSslProfileUrlCache": {
      "id": "#/definitions/InlineSslProfileUrlCache",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missAction": {
          "type": "string",
          "description": "The action to take if local URL category resolution misses",
          "enum": [
            "decrypt",
            "no-decrypt",
            "defer"
          ],
          "default": "no-decrypt"
        },
        "timeout": {
          "type": "integer",
          "format": "int32",
          "description": "defer timeout in seconds. Only applicable for missAction 'defer'",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        }
      }
    },
    "InlineSslProfileDecrypt": {
      "id": "#/definitions/InlineSslProfileDecrypt",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolBypass": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "tcp": {
          "$ref": "#/definitions/InlineSslProfileDecryptTcp",
          "description": "SSL decryption TCP control"
        }
      }
    },
    "InlineSslProfileNoDecrypt": {
      "id": "#/definitions/InlineSslProfileNoDecrypt",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolBypass": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfileToolConfig": {
      "id": "#/definitions/InlineSslProfileToolConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failAction": {
          "type": "string",
          "description": "Action to take if the tool fails",
          "enum": [
            "fail-open",
            "fail-close"
          ],
          "default": "fail-open"
        },
        "earlyEngage": {
          "type": "boolean",
          "default": false,
          "description": "enable/disable tool early engage"
        }
      }
    },
    "InlineSslProfileNonSslTcp": {
      "id": "#/definitions/InlineSslProfileNonSslTcp",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolBypass": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfileSplitProxy": {
      "id": "#/definitions/InlineSslProfileSplitProxy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "serverNonPfsCiphers": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfileResilientInline": {
      "id": "#/definitions/InlineSslProfileResilientInline",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InboundToolEarlyInspect": {
      "id": "#/definitions/InboundToolEarlyInspect",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "connectionTimeout": {
          "type": "integer",
          "format": "int32",
          "description": "connection timeout timeout in seconds.",
          "minimum": 1,
          "maximum": 10,
          "default": 10
        }
      }
    },
    "InlineSslProfileToolL3": {
      "id": "#/definitions/InlineSslProfileToolL3",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "natPat": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "http2Downgrade": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "cacheServerCertTimeout": {
          "type": "integer",
          "format": "int32",
          "description": "cache server timeout in seconds.",
          "minimum": 1,
          "maximum": 1440,
          "default": 30
        }
      }
    },

    "InlineSslProfileHa": {
      "id": "#/definitions/InlineSslProfileHa",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeStandby": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfileNetworkGroup": {
      "id": "#/definitions/InlineSslProfileNetworkGroup",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multipleEntry": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        }
      }
    },
    "InlineSslProfileStartTls": {
      "id": "#/definitions/InlineSslProfileStartTls",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "l4port": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "InlineSslProfileDecryptConfig": {
      "id": "#/definitions/InlineSslProfileDecryptConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolBypass": {
          "$ref": "#/definitions/InlineSslGenericEnableFalse"
        },
        "tcp": {
          "$ref": "#/definitions/InlineSslProfileDecryptTcpConfig",
          "description": "SSL decryption TCP control"
        }
      }
    },
    "InlineSslProfileDecryptTcp": {
      "id": "#/definitions/InlineSslProfileDecryptTcp",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactiveTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 2,
          "maximum": 1440,
          "default": 5,
          "description": "SSL decryption TCP inactive timeout (in minutes)"
        },
        "portMap": {
          "description": "SSL decryption port map",
          "$ref": "#/definitions/InlineSslProfileDecryptTcpPortMap"
        }
      }
    },
    "InlineSslProfileDecryptTcpConfig": {
      "id": "#/definitions/InlineSslProfileDecryptTcpConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactiveTimeout": {
          "type": "integer",
          "format": "int32",
          "minimum": 2,
          "maximum": 1440,
          "default": 5,
          "description": "SSL decryption TCP inactive timeout (in minutes)"
        },
        "portMap": {
          "description": "SSL decryption port map",
          "$ref": "#/definitions/InlineSslProfileDecryptTcpPortMapConfig"
        }
      }
    },
    "InlineSslProfileDecryptTcpPortMap": {
      "id": "#/definitions/InlineSslProfileDecryptTcpPortMap",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultOutPort": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65536,
          "description": "egress port for decryption port map. 0 is disabled.",
          "default": 0
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InlineSslProfileDecryptTcpPortMapPorts"
          }
        }
      }
    },
    "InlineSslProfileDecryptTcpPortMapConfig": {
      "id": "#/definitions/InlineSslProfileDecryptTcpPortMapConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultOutPort": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 65536,
          "description": "egress port for decryption port map. 0 is disabled.",
          "default": 0
        }
      }
    },
    "InlineSslProfileDecryptTcpPortMaps": {
      "id": "#/definitions/InlineSslProfileDecryptTcpPortMaps",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portMaps"
      ],
      "properties": {
        "portMaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InlineSslProfileDecryptTcpPortMapPorts"
          }
        }
      }
    },
    "InlineSslProfileDecryptTcpPortMapPorts": {
      "id": "#/definitions/InlineSslProfileDecryptTcpPortMapPorts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inPort",
        "outPort"
      ],
      "properties": {
        "ruleId": {
          "type": "integer",
          "readonly": true,
          "example": 1
        },
        "inPort": {
          "type": "integer",
          "format": "int32",
          "description": "ingress port for decryption port map",
          "minimum": 1,
          "maximum": 65536
        },
        "outPort": {
          "type": "integer",
          "format": "int32",
          "description": "egress port for decryption port map",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "InlineSslProfileCertificate": {
      "id": "#/definitions/InlineSslProfileCertificate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expired": {
          "type": "string",
          "description": "SSL profile on expired certificate",
          "enum": [
            "decrypt",
            "drop"
          ],
          "default": "drop"
        },
        "invalid": {
          "type": "string",
          "description": "SSL profile on invalid certificate",
          "enum": [
            "decrypt",
            "drop"
          ],
          "default": "drop"
        },
        "revocation": {
          "$ref": "#/definitions/InlineSslProfileCertRevoke",
          "description": "SSL profile certificate revocation configuration"
        },
        "selfSigned": {
          "type": "string",
          "description": "SSL profile on self-signed certificate",
          "enum": [
            "decrypt",
            "drop"
          ],
          "default": "drop"
        },
        "unknownCa": {
          "type": "string",
          "description": "SSL profile on unknown CA certificate",
          "enum": [
            "decrypt",
            "drop"
          ],
          "default": "drop"
        }
      }
    },
    "InlineSslProfileCertRevoke": {
      "id": "#/definitions/InlineSslProfileCertRevoke",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crl": {
          "$ref": "#/definitions/InlineSslProfileCertRevokeConfig",
          "description": "SSL profile certificate revocation configuration"
        },
        "ocsp": {
          "$ref": "#/definitions/InlineSslProfileCertRevokeConfig",
          "description": "SSL profile certificate revocation configuration"
        }
      }
    },
    "InlineSslProfileCertRevokeConfig": {
      "id": "#/definitions/InlineSslProfileCertRevokeConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "fail": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ],
          "description": "only applicable when enabled"
        },
        "defer": {
          "type": "integer",
          "format": "int32",
          "minimum": 20,
          "maximum": 100,
          "description": "timeout in seconds"
        }
      }
    },
    "InlineSslProfileRuleDomain": {
      "id": "#/definitions/InlineSslProfileRuleDomain",
      "type": "object",
      "additionalProperties": false,
      "description": "domain rule",
      "required": [
        "type",
        "value",
        "action"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "domain"
          ]
        },
        "ruleId": {
          "type": "integer",
          "readonly": true,
          "example": 1
        },
        "value": {
          "type": "string",
          "format": "hostname",
          "description": "hostname string. e.g. gigamon.com"
        },
        "action": {
