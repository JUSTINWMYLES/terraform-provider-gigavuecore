{
  "id": "http://gigamon.com/schemas-fm/domain.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Managed Physical Gigamon Device Domain schema",
  "definitions": {
    "GigaDomain": {
      "id": "#/definitions/GigaDomain",
      "type": "object",
      "additionalProperties": true,
      "description": "Gigamon Physical Node Domain",
      "required": [
        "domainName",
        "devices"
      ],
      "properties": {
        "domainName": {
          "type": "string",
          "minLength": 1
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaDevice"
          }
        }
      }
    },
    "GigaDevice": {
      "id": "#/definitions/GigaDevice",
      "type": "object",
      "additionalProperties": true,
      "description": "Represents a managed physical Gigamon device",
      "required": [
        "deviceId",
        "deviceIp",
        "family",
        "model"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "unique ID representing this managed Gigamon device"
        },
        "deviceIp": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "device management IP Address"
        },
        "topoNodeId": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "unique topology node ID. Generated by FM server"
        },
        "natIp": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "Device NAT IP Address. Applicable for only devices behind NAT set up"
        },
        "dnsName": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "device DNS name, as registered in DNS server"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "description": "device configured hostname"
        },
        "family": {
          "type": "string",
          "enum": [
            "H",
            "G"
          ],
          "readonly": true
        },
        "model": {
          "$ref": "../schemas-common/common.json#/definitions/GigaDeviceModel",
          "readonly": true,
          "description": "Device model"
        },
        "boxId": {
          "type": "string",
          "minLength": 1,
          "readonly": true
        },
        "swVersion": {
          "type": "string",
          "minLength": 1,
          "readonly": true
        },
        "swBuildNumber": {
          "type": "string",
          "minLength": 1,
          "readonly": true
        },
        "licensed": {
          "type": "boolean",
          "readonly": true
        },
        "clusterMode": {
          "deprecated": true,
          "type": "string",
          "enum": [
            "standalone",
            "master",
            "standby",
            "slave",
            "vfex"
          ],
          "default": "standalone",
          "readonly": true,
          "description": "standalone: not a member of any cluster/stack; master: cluster/stack master; standby: for H-series only; slave: non-master member of an H-series cluster or a slave in a G-series stack; vfex: visibility fabric extender of an H-Series cluster. (deprecated: use clusterModeAlias)"
        },
        "clusterModeAlias": {
          "type": "string",
          "enum": [
            "standalone",
            "leader",
            "standby",
            "member",
            "vfex"
          ],
          "default": "standalone",
          "readonly": true,
          "description": "standalone: not a member of any cluster/stack; leader: cluster/stack leader; standby: for H-series only; member: non-leader member of an H-series cluster or a member in a G-series stack; vfex: visibility fabric extender of an H-Series cluster"
        },
        "clusterState": {
          "type": "string",
          "enum": [
            "online",
            "failed",
            "init",
            "searching",
            "joining",
            "creating",
            "waiting",
            "leaving",
            "join-sync",
            "removed",
            "regroup"
          ],
          "default": "init",
          "readonly": true,
          "description": "Describes the cluster membership state. Applicable only for clustered H-series devices"
        },
        "operStatus": {
          "type": "string",
          "enum": [
            "operational",
            "safe",
            "limited"
          ],
          "readonly": true,
          "description": "Describes device operational state. 'operational': fully configurable; 'safe': no configuration possible; 'limited': limited configuration possible. Applicable only for H-series devices"
        },
        "chassisOperStatus": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "not-reachable"
          ],
          "readonly": true,
          "description": "Describes operational state available in Chassis information. 'up': node is up; 'down': node is down; 'left': node is left from the cluster; 'not-reachable': node is not reachable from the cluster' . Applicable only for H-series devices"
        },
        "clusterMaster": {
          "deprecated": true,
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "address of stack/cluster master device. (deprecated: use clusterLeader)"
        },
        "clusterLeader": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "address of stack/cluster leader device"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "applicable only for clustered H-series devices"
        },
        "clusterVip": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "applicable only for clustered H-series devices"
        },
        "masterPref": {
          "deprecated": true,
          "type": "integer",
          "format": "int16",
          "minimum": 0,
          "readonly": true,
          "description": "master election preference rank. (deprecated: use leaderPref)"
        },
        "leaderPref": {
          "type": "integer",
          "format": "int16",
          "minimum": 0,
          "readonly": true,
          "description": "leader election preference rank"
        },
        "deviceIps": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ipv4"
          },
          "readonly": true,
          "description": "list of all the IPs on the device"
        },
        "discOutcome": {
          "type": "string",
          "enum": [
            "ok",
            "connFailed",
            "authFailed",
            "parseFailed"
          ],
          "readonly": true,
          "description": "status of FM-to-device communication channel"
        },
        "disconnected": {
          "type": "boolean",
          "readonly": true,
          "description": "Status of connection between FM and Device"
        },
        "failureDesc": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "reason for device discovery failure"
        },
        "healthState": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthState"
        },
        "healthStateReasons": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthStateReasons"
        }
      }
    },
    "GigaCluster": {
      "id": "#/definitions/GigaCluster",
      "type": "object",
      "additionalProperties": true,
      "description": "Represents an H-series cluster or a G-series Stack",
      "required": [
        "leaderId"
      ],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "H",
            "G"
          ],
          "readonly": true,
          "description": "identifies whether this is an H-series cluster or a G-series stack"
        },
        "masterId": {
          "deprecated": true,
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "id of stack's master device. (deprecated: use leaderId)"
        },
        "leaderId": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "id of stack's leader device"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "for H-series clusters only. Identifies the configured cluster id"
        },
        "clusterVip": {
          "type": "string",
          "format": "ipv4",
          "readonly": true,
          "description": "for H-series clusters only. Identifies the configured cluster VIP address"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaDevice"
          },
          "readonly": true
        },
        "healthState": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthState"
        },
        "healthStateReasons": {
          "$ref": "../schemas-common/common.json#/definitions/EntityHealthStateReasons"
        }
      }
    },
    "DeviceAddSpecs": {
      "id": "#/definitions/DeviceAddSpecs",
      "type": "object",
      "additionalProperties": true,
      "description": "Request to add new nodes to management domain",
      "required": [
        "nodeAddSpecs"
      ],
      "properties": {
        "nodeAddSpecs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeviceAddSpec"
          }
        }
      }
    },
    "DeviceAddSpec": {
      "id": "#/definitions/DeviceAddSpec",
      "type": "object",
      "additionalProperties": true,
      "description": "Request to add a new node to management domain. HttpsPort value is required if non-default(i.e other than 443) is configured in device",
      "required": [
        "nodeAddress"
      ],
      "properties": {
        "nodeAddress": {
          "type": "string",
          "format": "ipv4"
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "httpsPort": {
          "type": "string",
          "default": "443",
          "description": "The default value used is 443. If changed in the device same should be given here"
        },
        "snmpVersion": {
          "type": "string",
          "enum": [
            "v2",
            "v3"
          ],
          "description": "SNMP version to use.",
          "defaultValue": "v2"
        }
      }
    },
    "DeviceDiscoveryResult": {
      "id": "#/definitions/DeviceDiscoveryResult",
      "type": "object",
      "additionalProperties": true,
      "description": "summary of device discovery",
      "required": [
        "deviceAddress"
      ],
      "properties": {
        "deviceAddress": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "device management address"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "connFailed",
            "authFailed",
            "commFailed"
          ],
          "readonly": true,
          "description": "device discovery outcome"
        },
        "deviceDetails": {
          "$ref": "#/definitions/GigaDevice",
          "readonly": true,
          "description": "For successful discovery, contains details of the discovered device"
        }
      }
    },
    "ClusterDiscoveryResult": {
      "id": "#/definitions/ClusterDiscoveryResult",
      "type": "object",
      "additionalProperties": true,
      "description": "Result of a cluster discovery. For Standalones, only a single node is reported",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "H",
            "G"
          ],
          "readonly": true
        },
        "clusterMasterId": {
          "deprecated": true,
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "unique ID representing this Cluster Master device. (deprecated: use clusterLeaderId)"
        },
        "clusterLeaderId": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "unique ID representing this Cluster Leader device"
        },
        "clusterId": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "Only applicable for H-series clusters"
        },
        "clusterVip": {
          "type": "string",
          "readonly": true,
          "minLength": 1,
          "description": "Only applicable for H-series clusters"
        },
        "discovered": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeviceDiscoveryResult"
          },
          "readonly": true,
          "description": "Successfully discovered cluster members"
        },
        "failed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeviceDiscoveryResult"
          },
          "readonly": true,
          "description": "Known cluster members that failed to get fully [re-]discovered"
        }
      }
    },
    "MultiClusterDiscoveryResult": {
      "id": "#/definitions/MultiClusterDiscoveryResult",
      "type": "object",
      "additionalProperties": true,
      "description": "summary of multi-cluster discovery",
      "required": [
        "clusters"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClusterDiscoveryResult"
          },
          "readonly": true
        }
      }
    },
    "GigaDeviceQueryResponse": {
      "id": "#/definitions/GigaDeviceQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "$ref": "#/definitions/GigaDevice"
        }
      }
    },
    "GigaDevicesQueryResponse": {
      "id": "#/definitions/GigaDevicesQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaDevice"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    },
    "GigaClusterQueryResponse": {
      "id": "#/definitions/GigaClusterQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cluster"
      ],
      "properties": {
        "cluster": {
          "$ref": "#/definitions/GigaCluster"
        }
      }
    },
    "GigaClustersQueryResponse": {
      "id": "#/definitions/GigaClustersQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "clusters"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaCluster"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    }
  }
}
