{
  "id": "http://gigamon.com/schemas-fm/topology.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Gigamon Topology schema",
  "definitions": {
    "GigaTopology": {
      "id": "#/definitions/GigaTopology",
      "type": "object",
      "additionalProperties": true,
      "description": "Gigamon topology graph",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/GigaTopologyGigamonNode"
              },
              {
                "$ref": "#/definitions/GigaTopologyManualNode"
              },
              {
                "$ref": "#/definitions/GigaTopologyLldpNode"
              },
              {
                "$ref": "#/definitions/GigaTopologyCdpNode"
              }
            ]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaTopologyNodeLink"
          }
        }
      }
    },
    "GigaTopologyGigamonNode": {
      "id": "#/definitions/GigaTopologyGigamonNode",
      "type": "object",
      "additionalProperties": true,
      "description": "Gigamon Topology Node",
      "required": [
        "topoNodeId",
        "topoNodeType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "unique topology node ID. Generated by FM server"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "gigamon"
          ],
          "description": "indicates how node became a part of the topology graph"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "Gigamon Device Id. Used to cross-reference corresponding Gigamon inventory node"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "description": "Gigamon cluster Id"
        },
        "clusterMode": {
          "type": "string",
          "enum": [
            "standalone",
            "master",
            "standby",
            "slave",
            "vfex"
          ],
          "description": "Gigamon physical device mode"
        },
        "hostname": {
          "type": "string",
          "description": "Gigamon physical device hostname"
        },
        "boxId": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "enum": [
            "HD8",
            "HD4",
            "HC2",
            "HB1",
            "TA1",
            "TA10",
            "TA40",
            "TA100",
            "GV2404",
            "GV420",
            "GV212",
            "GV216",
            "OS"
          ],
          "description": "Gigamon physical device models"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyManualNode": {
      "id": "#/definitions/GigaTopologyManualNode",
      "type": "object",
      "additionalProperties": true,
      "description": "Manually-added Topology Node",
      "required": [
        "topoNodeId",
        "topoNodeType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "unique topology node ID. Generated by FM server"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "manual"
          ],
          "description": "indicates how node became a part of the topology graph"
        },
        "nodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Node alias. User-assigned"
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "description": "Node vendor, if available"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Annotation: type of a node. E.g. switch, router, etc..."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Node model, if available"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyManualNodeSpec": {
      "id": "#/definitions/GigaTopologyManualNodeSpec",
      "type": "object",
      "additionalProperties": true,
      "description": "Manually-added Topology Node",
      "required": [
        "nodeAlias"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "description": "Node's unique identifier. Auto-assigned. This is required while updating existing node"
        },
        "nodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Node alias. User-assigned"
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "description": "Node vendor, if available"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Annotation: type of a node. E.g. switch, router, etc..."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Node model, if available"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyLldpNode": {
      "id": "#/definitions/GigaTopologyLldpNode",
      "type": "object",
      "additionalProperties": true,
      "description": "LLDP-discovered Topology Node",
      "required": [
        "topoNodeId",
        "topoNodeType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "unique topology node ID. Generated by FM server"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "lldp"
          ],
          "description": "indicates how node became a part of the topology graph"
        },
        "chassisId": {
          "type": "string",
          "minLength": 1,
          "description": "LLDP Neighbor Chassis Id"
        },
        "sysName": {
          "type": "string"
        },
        "sysDescr": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyCdpNode": {
      "id": "#/definitions/GigaTopologyCdpNode",
      "type": "object",
      "additionalProperties": true,
      "description": "CDP-discovered Topology Node",
      "required": [
        "topoNodeId",
        "topoNodeType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "readonly": true,
          "description": "unique topology node ID. Generated by FM server"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "cdp"
          ],
          "description": "indicates how node became a part of the topology graph"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "CDP Neighbor Device Id"
        },
        "platform": {
          "type": "string"
        },
        "swVersion": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyNodeLink": {
      "id": "#/definitions/GigaTopologyNodeLink",
      "type": "object",
      "additionalProperties": true,
      "description": "Topology Link interconnecting two nodes",
      "required": [
        "topoLinkType",
        "gigaLinkType",
        "endpoint1",
        "endpoint2"
      ],
      "properties": {
        "topoLinkId": {
          "type": "string",
          "minLength": 1,
          "description": "unique Id representing a topology graph link. Generated by FM server"
        },
        "topoLinkType": {
          "type": "string",
          "enum": [
            "gigamon",
            "manual",
            "lldp",
            "cdp"
          ],
          "description": "indicates how link became a pert of this topology graph"
        },
        "gigaLinkType": {
          "type": "string",
          "enum": [
            "gigastream",
            "port"
          ],
          "description": "specifies whether this is a gigastream-based or port-based link. Only applicable for topoNodeType of 'gigamon'"
        },
        "manualOverride": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether manual augmentation exist. Only applicable for topoLinkType of 'cdp' or 'lldp'"
        },
        "endpoint1": {
          "$ref": "#/definitions/GigaTopologyNodeLinkEndpoint"
        },
        "endpoint2": {
          "$ref": "#/definitions/GigaTopologyNodeLinkEndpoint"
        },
        "connections": {
          "description": "Actual port-ids which are part of the physical connection",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port1": {
                "type": "string"
              },
              "port2": {
                "type": "string"
              }
            }
          }
        },
        "linkState": {
          "type": "string",
          "enum": [
            "connected",
            "disconnected",
            "unknown"
          ],
          "description": "specifies health state"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyNodeLinkEndpoint": {
      "id": "#/definitions/GigaTopologyNodeLinkEndpoint",
      "type": "object",
      "additionalProperties": true,
      "description": "node link endpoint",
      "required": [
        "topoNodeId",
        "topoNodeType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "description": "Topology graph node Id. References one of the Topology Nodes in the graph"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "gigamon",
            "manual",
            "lldp",
            "cdp"
          ],
          "description": "topology node type"
        },
        "nodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Node alias. References user-assigned topology node alias. Internal use only"
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "description": "For 'gigamon': this is the portId (e.g. '1/1/x1'). For 'lldp'/'cdp': this is the 'portId' as reported by neighbor discovery. For 'manual': this is user provided or may be omitted"
        },
        "componentAlias": {
          "type": "string",
          "minLength": 1,
          "description": "For 'gigamon': this is either portId (e.g. '1/1/x1') or Gigastream alias (e.g. 'gs1'). For 'lldp'/'cdp': this is the 'portId' as reported by neighbor discovery. For 'manual': this is user provided or may be omitted"
        },
        "componentType": {
          "type": "string",
          "enum": [
            "Port",
            "GigaStream"
          ],
          "description": "Type of the endpoint component. This is either 'Port' or 'GigaStream'"
        },
        "componentPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For the component type gigastream, this specifies the array of port Ids that forms the logical group"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyNodeManualLinkSpec": {
      "id": "#/definitions/GigaTopologyNodeManualLinkSpec",
      "type": "object",
      "additionalProperties": true,
      "description": "Manual Topology Link Create/Update Spec",
      "required": [
        "endpoint1",
        "endpoint2"
      ],
      "properties": {
        "topoLinkId": {
          "type": "string",
          "minLength": 1,
          "description": "Link's unique identifier. Auto-assigned. This is required while updating existing links"
        },
        "endpoint1": {
          "$ref": "#/definitions/GigaTopologyNodeManualLinkEndpointSpec"
        },
        "endpoint2": {
          "$ref": "#/definitions/GigaTopologyNodeManualLinkEndpointSpec"
        },
        "connections": {
          "description": "Actual port ids which are part of the physical connection",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port1": {
                "type": "string"
              },
              "port2": {
                "type": "string"
              }
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyNodeManualLinkEndpointSpec": {
      "id": "#/definitions/GigaTopologyNodeManualLinkEndpointSpec",
      "type": "object",
      "additionalProperties": true,
      "description": "Node link endpoint Create/Update Spec",
      "required": [
        "topoNodeId",
        "componentType"
      ],
      "properties": {
        "topoNodeId": {
          "type": "string",
          "minLength": 1,
          "description": "Topology graph node Id. References one of the Topology Nodes in the graph"
        },
        "topoNodeType": {
          "type": "string",
          "enum": [
            "manual"
          ],
          "default": "manual",
          "description": "topology node type"
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "description": "For 'gigamon': this is the portId (e.g. '1/1/x1'). For 'manual': this is user provided or may be omitted"
        },
        "componentAlias": {
          "type": "string",
          "minLength": 1,
          "description": "For 'gigamon': this is either portId (e.g. '1/1/x1') or Gigastream alias (e.g. 'gs1').  For 'manual': this is user provided or may be omitted"
        },
        "componentType": {
          "type": "string",
          "enum": [
            "Port",
            "GigaStream"
          ],
          "description": "Type of the endpoint component. This is either 'Port' or 'GigaStream'"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "GigaTopologyQueryResponse": {
      "id": "#/definitions/GigaTopologyQueryResponse",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "gigaTopology"
      ],
      "properties": {
        "gigaTopology": {
          "$ref": "#/definitions/GigaTopology"
        }
      }
    },
    "GigaTopologyManualEntityBulkUpdateSpec": {
      "id": "#/definitions/GigaTopologyManualEntityBulkUpdateSpec",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaTopologyManualNodeSpec"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GigaTopologyNodeManualLinkSpec"
          }
        }
      }
    },
    "GigaTopologyManualEntityBulkDeleteSpec": {
      "id": "#/definitions/GigaTopologyManualEntityBulkDeleteSpec",
      "type": "object",
      "description": "",
      "properties": {
        "nodes": {
          "type": "array",
          "description": "Array of ids of nodes to be deleted",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "description": "Array of ids of links to be deleted",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GigaTopologyManualBulkCreateResponse": {
      "id": "#/definitions/GigaTopologyManualBulkCreateResponse",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "properties": {
            "created": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "created": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            }
          }
        }
      }
    },
    "GigaTopologyManualBulkUpdateResponse": {
      "id": "#/definitions/GigaTopologyManualBulkUpdateResponse",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "properties": {
            "updated": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkUpdateResponse"
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "updated": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkUpdateResponse"
              }
            }
          }
        }
      }
    },
    "GigaTopologyManualBulkDeleteResponse": {
      "id": "#/definitions/GigaTopologyManualBulkDeleteResponse",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "properties": {
            "deleted": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkDeleteResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkDeleteResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyNodeBulkDeleteResponse"
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "deleted": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkDeleteResponse"
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkDeleteResponse"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GigaTopologyLinkBulkDeleteResponse"
              }
            }
          }
        }
      }
    },
    "GigaTopologyNodeBulkUpdateResponse": {
      "id": "#/definitions/GigaTopologyNodeBulkUpdateResponse",
      "type": "object",
      "description": "Response structure for bulk create/update of manual topology nodes",
      "required": [
        "nodeAlias"
      ],
      "properties": {
        "nodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Alias of the manual node specified by the used in create/update spec"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "description": "TopoNodeId generated for the successfully added manual nodes"
        },
        "reasons": {
          "type": "string",
          "minLength": 1,
          "description": "Reasons for skip/failure in adding manual node"
        }
      }
    },
    "GigaTopologyLinkBulkUpdateResponse": {
      "id": "#/definitions/GigaTopologyLinkBulkUpdateResponse",
      "type": "object",
      "description": "Response structure for bulk create/update of manual topology links",
      "required": [
        "endPoint1NodeAlias",
        "endPoint1Component",
        "endPoint2NodeAlias",
        "endPoint2Component"
      ],
      "properties": {
        "endPoint1NodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Alias of the manual node specified as endpoint1 specified in the link create/update spec"
        },
        "endPoint1Component": {
          "type": "string",
          "minLength": 1,
          "description": "Alias of the endpoint1 component(portId/Gigastream alias) in the link create/update spec"
        },
        "endPoint2NodeAlias": {
          "type": "string",
          "minLength": 1,
          "description": "Alias of the manual node specified as endpoint2 specified in the link create/update spec"
        },
        "endPoint2Component": {
          "type": "string",
          "minLength": 1,
          "description": "Alias of the endpoint1 component(portId/Gigastream alias) in the link create/update spec"
        },
        "linkId": {
          "type": "string",
          "minLength": 1,
          "description": "LinkId generated for the successfully created links"
        },
        "reasons": {
          "type": "string",
          "minLength": 1,
          "description": "Reasons for skip/failure in adding manual link"
        }
      }
    },
    "GigaTopologyNodeBulkDeleteResponse": {
      "id": "#/definitions/GigaTopologyNodeBulkDeleteResponse",
      "type": "object",
      "description": "Response structure for bulk delete of manual topology nodes",
      "required": [
        "nodeId"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "string",
          "minLength": 1,
          "description": "Reasons for skip/failure in deleting manual node"
        }
      }
    },
    "GigaTopologyLinkBulkDeleteResponse": {
      "id": "#/definitions/GigaTopologyNodeBulkDeleteResponse",
      "type": "object",
      "description": "Response structure for bulk delete of manual topology nodes",
      "required": [
        "linkId"
      ],
      "properties": {
        "linkId": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "string",
          "minLength": 1,
          "description": "Reasons for skip/failure in deleting manual link"
        }
      }
    },

    "TopologyEntityImportResponse": {
      "id": "#/definitions/TopologyEntityImportResponse",
      "type": "object",
      "$ref" : "#/definitions/GigaTopologyManualBulkUpdateResponse"
    }
  }
}
