{
  "id": "http://gigamon.com/schemas-fm/sffpProfiles.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Subscriber Flow Forwarding Protocol Profile Schema",
  "definitions": {
    "SffpProfile": {
      "id": "#/definitions/SffpProfile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "profiles"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Alias of the SFFP Profile"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "$ref": "#/definitions/ProfileSpec"
          }
        }
      }
    },
    "ProfileSpec": {
      "id": "#/definitions/ProfileSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipInterface",
        "nodeType",
        "portList",
        "sxInterface"
      ],
      "properties": {
        "ipInterface": {
          "type": "string",
          "format": "ipv4"
        },
        "nodeType": {
          "type": "string",
          "enum": [
            "control",
            "user"
          ]
        },
        "portList": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "sxInterface": {
          "$ref": "#/definitions/SxInterface"
        }
      }
    },
    "SxInterface": {
      "id": "#/definitions/SxInterface",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "ipAddresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        }
      }
    },
    "SffpProfileQueryResponse": {
      "id": "#/definitions/SffpProfileQueryResponse",
      "type": "object",
      "since": "H5.8",
      "required": [
        "sffpProfile"
      ],
      "properties": {
        "sffpProfile": {
          "$ref": "#/definitions/SffpProfile"
        }
      }
    },
    "SffpProfilesQueryResponse": {
      "id": "#/definitions/SffpProfilesQueryResponse",
      "type": "object",
      "since": "H5.8",
      "required": [
        "sffpProfiles"
      ],
      "properties": {
        "sffpProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SffpProfile"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    }
  }
}
