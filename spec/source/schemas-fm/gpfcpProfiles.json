{
  "id": "http://gigamon.com/schemas-fm/gpfcpProfiles.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "GPFCP Profile Schema",
  "definitions": {
    "GpfcpProfile": {
      "id": "#/definitions/GpfcpProfile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "gProfiles"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Alias of the Gpfcp Profile"
        },
        "comment": {
          "type": "string",
          "description": "Description of the Gpfcp Profile"
        },
        "gProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "$ref": "#/definitions/ProfileSpec"
          }
        }
      }
    },
    "ProfileSpec": {
      "id": "#/definitions/ProfileSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipInterface",
        "nodeType",
        "portList",
        "gInterface"
      ],
      "properties": {
        "ipInterface": {
          "type": "string",
          "format": "ipv4"
        },
        "nodeType": {
          "type": "string",
          "enum": [
            "control",
            "user"
          ]
        },
        "portList": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "gInterface": {
          "$ref": "#/definitions/Interface"
        },
        "comment": {
          "type": "string",
          "description": "Description of the Gpfcp Profile Rule"
        }
      }
    },
    "Interface": {
      "id": "#/definitions/Interface",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "ipAddresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        }
      }
    },
    "GpfcpProfileQueryResponse": {
      "id": "#/definitions/GpfcpProfileQueryResponse",
      "type": "object",
      "since": "H6.8",
      "required": [
        "gpfcpProfile"
      ],
      "properties": {
        "gpfcpProfile": {
          "$ref": "#/definitions/GpfcpProfile"
        }
      }
    },
    "GpfcpProfilesQueryResponse": {
      "id": "#/definitions/GpfcpProfilesQueryResponse",
      "type": "object",
      "since": "H6.8",
      "required": [
        "gpfcpProfiles"
      ],
      "properties": {
        "gpfcpProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GpfcpProfile"
          }
        },
        "context": {
          "$ref": "../schemas-common/common.json#/definitions/QueryResultContext"
        }
      }
    }
  }
}
