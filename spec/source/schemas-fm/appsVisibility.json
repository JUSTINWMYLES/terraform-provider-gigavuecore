        "appsVisibilitySolutions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AppsVisibilitySolutionGetSpec"
          }
        }
      }
    },
    "AppsVisibilitySolutionQueryResponse": {
      "id": "#/definitions/AppsVisibilitySolutionQueryResponse",
      "type": "object",
      "additionalProperties": false,
      "properties": {
