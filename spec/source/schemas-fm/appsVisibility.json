    "SessionAwareApfProfile": {
      "id": "#/definitions/SessionAwareApfProfile",
      "description": "Session-Aware APF",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "sessionFields"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "sessionFields": {
          "type": "array",
          "items": {
            "$ref": "apps.json#/definitions/SessionAwareApfField"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "description": "A sessionField cannot contain overlapping session attribute, position pairs (e.g. ipv4-5tuple pos 1 and ipv4-src pos 1 is not allowed). Max number of session fields is 20"
        },
        "timeout": {
          "type": "integer",
          "format": "int16",
          "minimum": 10,
          "maximum": 120,
          "default": 15,
          "description": "in seconds"
        },
        "bidi": {
          "type": "boolean",
          "default": true,
          "description": "include reverse traffic for the selected sessionFields. Not applicable for 'mplsLabel', 'gtpuTeid', 'vlanId'"
        },
        "buffering": {
