            },
            "sapfProfileAlias": {
              "type": "string",
              "description": "Alias of the SAPF Profile"
            },
            "appFilterTieredBatchId": {
              "type": "string",
              "description": "ID of the appFilterConfig tiered batch"
            },
            "egressTrafficConfigs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EgressTrafficConfigGetSpec"
              }
            }
          }
        },
        "dedup": {
          "type": "object",
