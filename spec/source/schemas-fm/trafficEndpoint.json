          }
        }
      }
    },
    "trafficEndpoint-update": {
      "id": "#/definitions/trafficEndpoint-update",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterId"
      ],
      "properties": {
        "clusterId": {
          "type": "string",
          "minLength": 1,
          "description": "id of the defining cluster"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "component.json#/definitions/components-update",
            "description": "Detailed definition of this component"
          }
        }
      }
    }
  }
