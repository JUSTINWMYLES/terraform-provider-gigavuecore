action "gigavuecore_reset_template_value_to_global" "example" {
  config {
    body_config_type   = "example"
    config             = null
    config_level       = "example"
    config_level_value = [ "example" ]
    config_resource    = null
    config_type        = "example"
    modifiable         = true
    ref_count          = 1
    ref_object         = null
    template_name      = "example"
    update_time        = "example"
  }
}
