action "gigavuecore_update_system_web_configuration" "example" {
  config {
    auto_logout_timeout = 1
    cluster_id = "example"
    cluster_name = "example"
    enable_https = true
    http_port = 1
    https_port = 1
    server_ssl_min_version = "example"
    session_renewal = 1
    session_timeout = 1
  }
}
